# Local G01 development credentials. Copy to .env and replace every value.
MINIO_ROOT_USER=replace-me-minio-user
MINIO_ROOT_PASSWORD=replace-me-minio-password
ICEBERG_DB_USER=replace-me-iceberg-user
ICEBERG_DB_PASSWORD=replace-me-iceberg-password

# Single-host Spark Standalone development resources.
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=4g
SPARK_APPLICATION_CORES=2
SPARK_EXECUTOR_CORES=2
SPARK_EXECUTOR_MEMORY=2g

# Read-only FastAPI and Trino settings for local host development.
# Use TRINO_HOST=trino only when the API itself runs inside the Compose network.
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_USER=travel_api
TRINO_CATALOG=travel
TRINO_SCHEMA=gold
TRINO_HTTP_SCHEME=http
TRINO_REQUEST_TIMEOUT_SECONDS=10
GOLD_RELEASE_ID=gold-release-9bfd00eeae2748684dbc34e34aab27620f6babed6c8ad8ecfbf8f8fb558c6854
CORS_ORIGINS=http://localhost:5173
